#!/bin/bash

function save_wallpaper() {
  echo -e "$WALLPAPER_DIR/$FILE\n$FIT" > $SAVE_FILE
}

function restore_wallpaper() {
  GET_WALLPAPER=$(sed -n '1p' "$SAVE_FILE")
  GET_FIT=$(sed -n '2p' "$SAVE_FILE")
}

function save_fit() {
  restore_wallpaper
  echo -e "$GET_WALLPAPER\n$FIT" > $SAVE_FILE
}

function kde_wallpaper() {
  STRING="string:
  var Desktops = desktops();
  for (i=0;i<Desktops.length;i++) {
    d = Desktops[i];
    d.wallpaperPlugin = \"org.kde.image\";
    d.currentConfigGroup = Array(\"Wallpaper\", \"org.kde.image\", \"General\");
    d.writeConfig(\"Image\", \"file:///${WALLPAPER_DIR}/${FILE}\");
    d.writeConfig(\"Color\", \"${COLOR}\");
    d.writeConfig(\"FillMode\", ${FIT});
  }"

  SAVE=1
  if [[ -z "$COLOR" ]]; then
    STRING="string:
    var Desktops = desktops();
    for (i = 0; i < Desktops.length; i++) {
      d = Desktops[i];
      d.wallpaperPlugin = \"org.kde.image\";
      d.currentConfigGroup = Array(\"Wallpaper\", \"org.kde.image\", \"General\");
      d.writeConfig(\"FillMode\", $FIT);
    }"
    SAVE=0
  fi

  dbus-send --session --dest=org.kde.plasmashell --type=method_call \
    /PlasmaShell org.kde.PlasmaShell.evaluateScript "${STRING}"
  STATUS=$(echo $?)
  if [ $STATUS -ne 0 ]; then
    return
  fi
  if [ $SAVE -eq 1 ]; then
    save_wallpaper
  fi
}

# No bg color to set with hyprpaper :(
function hyprland_wallpaper() {
  PID=$(pgrep hyprpaper)
  if [[ -z "$PID" ]]; then
    echo "hyprpaper is not running"
    exit 1
  fi

  WALLPAPER="$WALLPAPER_DIR/$FILE"
  SAVE=1
  if [[ -z "$COLOR" ]]; then
    WALLPAPER=$(hyprctl hyprpaper listactive | awk '{print $NF}')
    SAVE=0
  fi

  if [[ "$FIT" == "2" ]]; then
    hyprctl hyprpaper wallpaper ",$WALLPAPER,fill"
    STATUS=$(echo $?)
  else
    hyprctl hyprpaper wallpaper ",$WALLPAPER,contain"
    STATUS=$(echo $?)
  fi
  if [ $STATUS -ne 0 ]; then
    return
  fi
  if [ $SAVE -eq 1 ]; then
    save_wallpaper
  fi
}

function change_wallpaper() {
  if [[ "$DE" == "Hyprland" ]]; then
    hyprland_wallpaper
  else
    kde_wallpaper
  fi
}

