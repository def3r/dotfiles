WALLPAPER_DIR=~/wallpapers
SAVE_FILE=~/.randwall
cd $WALLPAPER_DIR
count=$(ls -1 | wc -l)
rdm=$((RANDOM % (count + 1)))
FILE=$(ls -1 | sed -n "${rdm}p" | tr -d \\n)
FIT=1
COLOR=""
DE=$XDG_CURRENT_DESKTOP

if [[ $1 == "fill" ]]; then
  FIT=2
  change_wallpaper
  save_fit
  exit
elif [[ $1 == "fit" ]]; then
  change_wallpaper
  save_fit
  exit
fi

if [[ "$1" == "restore" ]]; then
  restore_wallpaper
  WALLPAPER_DIR=$(dirname "$GET_WALLPAPER")
  FILE=$(basename "$GET_WALLPAPER")
  FIT=$GET_FIT
else
  map_wallpaper "$1"
  if [[ $2 == "fill" ]]; then
    FIT=2
  fi
fi

echo RandWall @ $WALLPAPER_DIR
echo $FILE

if [[ "$DE" == "Hyprland" ]]; then
  COLOR="COLOR"
else
  COLOR=$(magick $WALLPAPER_DIR/$FILE -format %c -depth 8 -scale 144x144 histogram:info:- | sort -n | tail -1 | grep -o '#......')
fi
change_wallpaper
