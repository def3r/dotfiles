{
    "include": [
      "~/.config/waybar/modules/custom/dividers.jsonc",
      "~/.config/waybar/modules/custom/distro.jsonc",
      "~/.config/waybar/modules/custom/user.jsonc",
    ],

    "custom/sep#1": {
      "format": " ",
      "tooltip": false
    },

    "custom/full_block#1": {
      "format": "█",
      "tooltip": false
    },

    "custom/heavy_left_open#1": {
      "format": "❰",
      "tooltip": false
    },

    "custom/heavy_left_close#1": {
      "format": "❱",
      "tooltip": false
    },

    "height": 0,
    "width": 0,
    "margin": 0,
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "reload_style_on_change": true,

    "modules-left": [
      "group/user",
      "hyprland/workspaces",
      "custom/heavy_left_open#1",
      "hyprland/window",
      "custom/heavy_left_close#1"
    ],

    "modules-center": [
      "clock",
    ],

    "modules-right": [
      "temperature", "memory", "cpu",
      "pulseaudio",
      "network",
      "battery",
      "bluetooth",
      "custom/sep#1",
    ],

    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "nil",
        "on-click": "alacritty -e nmtui"
    },

    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "cpu": {
        "interval": 5,
        "format": "{usage}%  ",
        "tooltip": false
    },

    "memory": {
        "format": "{}%  "
    },

    "temperature": {
      "format": "{temperatureC}°C  ",
    },

    "bluetooth": {
      "format": " nil", // no need for no-connetions
      "format-connected": " {num_connections} connected",
      "on-click": "blueman-manager"
    },
}
